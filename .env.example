# Copy this file to ".env" (just the name .env, nothing before the dot) and paste your keys after the = signs.
# These keys only let the tracker READ public blockchain data. Never put a private key or seed phrase here.

# Solana (required for Solana). Free at https://dashboard.helius.dev
HELIUS_API_KEY=

# Base + BNB Chain (one key covers both). Free at https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# Fomo username -> wallet lookup. Free credits at https://www.fomoscan.sh
FOMOSCAN_API_KEY=
# Optional, paid: https://fomolens.app (key starts with fl_live_)
FOMOLENS_API_KEY=
# Optional backup lookup service (https://getfomoapi.fun). Leave empty if you don't have one.
FOMOAPI_KEY=

# ---- Optional settings (fine to leave as they are) ----
# Web address port: the dashboard opens at http://localhost:3000
PORT=3000
# How many recent transactions to load per Solana wallet when starting
HISTORY_PER_WALLET=5
# Extra check every N minutes in case a live message was missed (0 = off)
SAFETY_POLL_MINUTES=10
# Set to 1 to switch a chain off
DISABLE_BASE=0
DISABLE_BNB=0
