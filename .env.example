# Copy to .env.local and adjust. Restart the server after changes.

# --- Endpoints (public, no auth) ---
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Also supported: https://api.elections.kalshi.com/trade-api/v2
POLY_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLY_CLOB_BASE_URL=https://clob.polymarket.com

# --- Polling ---
# How often confirmed pairs' order books are re-fetched (ms).
POLL_INTERVAL_MS=15000
# How often the full open-market catalogs are re-pulled for matching (ms).
MARKET_REFRESH_INTERVAL_MS=1800000

# --- Throttling / retries ---
KALSHI_REQUESTS_PER_SECOND=10
POLY_REQUESTS_PER_SECOND=10
# Retries on HTTP 429 / 5xx / network errors, with exponential backoff (honours Retry-After).
HTTP_MAX_RETRIES=5
HTTP_TIMEOUT_MS=15000

# --- Opportunity rules ---
# Skip a pair if its two books were fetched further apart than this (ms).
STALENESS_MS=5000
# Required edge per contract in dollars. A chunk of q contracts is kept only if
# cost < q × (1 − MIN_EDGE_PER_CONTRACT). 0 = any positive edge after fees.
MIN_EDGE_PER_CONTRACT=0
# Max capital per trade used by the background scan / scan history (UI overrides per view).
DEFAULT_MAX_CAPITAL=1000
# Skip an opportunity if either leg's notional (before fees) is below this ($).
MIN_LEG_NOTIONAL=1
# Skip an opportunity with fewer contracts than this.
MIN_CONTRACTS=1

# --- Fees ---
# Kalshi taker fee = ceil_to_cent(RATE × multiplier × C × P × (1 − P)), per price level.
KALSHI_TAKER_FEE_RATE=0.07
# Per-series multiplier overrides, comma-separated SERIES=multiplier. Unlisted series use 1.
# Example: KALSHI_FEE_MULTIPLIERS=KXHIGHNY=0.5,KXSOMEFREESERIES=0
KALSHI_FEE_MULTIPLIERS=
# Treat Kalshi fees as 0 until a market's fee_waiver_expiration_time. Off = conservative.
KALSHI_HONOR_FEE_WAIVER=false
# Polymarket rate used when a fee-enabled market publishes no feeSchedule.rate (conservative).
POLY_FALLBACK_FEE_RATE=0.07

# --- Matching ---
MATCH_MAX_CLOSE_DAYS_APART=3
MATCH_MIN_SCORE=0.35
MATCH_MAX_CANDIDATES=200

# --- Storage / runtime ---
DB_PATH=./data/scanner.sqlite
# Set true to disable the background poller (scans then run only via "Scan now").
DISABLE_POLLER=false
